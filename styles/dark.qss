/* =============================================================================
   MKM Productivity System — Dark Theme

   Depth layers:
     bg_app    #111111   canvas utama
     bg_card   #1e1e1e   cards / panels
     bg_card2  #212121   card alternatif
     bg_input  #2a2a2a   input fields
     bg_btn    #2a2a2a   buttons (+ border untuk beri berat)
     bg_header #111111   table header

   Accent merah  #E60012  →  hover #C0000F
   ============================================================================= */

* {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #F3F4F6;
}

QMainWindow, QWidget {
    background-color: #111111;
}

/* ── Sidebar ── */
#sidebar {
    background-color: #0d0d0d;
    border-right: 1px solid #1e1e1e;
}

#logo_area {
    background-color: #111111;
    border-bottom: 1px solid #1e1e1e;
}

#sidebar_divider {
    background-color: #303030;
    max-height: 1px;
}

#sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    padding: 10px 10px 10px 40px;
    text-align: left;
    color: #555555;
    font-size: 10pt;
    min-height: 0px;
}

#sidebar QPushButton:hover {
    background-color: #212121;
    color: #F3F4F6;
    border-left: 3px solid #2e2e2e;
}

#sidebar QLabel#app_title {
    color: #E60012;
    font-size: 13pt;
    font-weight: bold;
    padding: 0;
    letter-spacing: 3px;
}

#sidebar QLabel#app_subtitle {
    color: #555555;
    font-size: 8pt;
    padding: 0;
    letter-spacing: 1px;
}

#sidebar QLabel#user_label {
    color: #6B7280;
    font-size: 9pt;
    padding-top: 8px;
}

/* ── Topbar ── */
#topbar {
    background-color: #181818;
    border-bottom: 1px solid #303030;
}

#lbl_page {
    font-size: 12pt;
    font-weight: bold;
    color: #F3F4F6;
}

/* ── Logout / Theme buttons ── */
#btn_logout {
    background-color: transparent;
    border: none;
    border-top: 1px solid #303030;
    padding: 12px 16px;
    text-align: left;
    color: #6B7280;
    font-size: 10pt;
    min-height: 40px;
}

#btn_logout:hover {
    background-color: #1e1e1e;
    color: #F3F4F6;
}

#btn_theme {
    background-color: transparent;
    border: none;
    border-top: 1px solid #303030;
    padding: 10px 16px;
    text-align: left;
    color: #6B7280;
    font-size: 10pt;
    min-height: 40px;
}

#btn_theme:hover {
    background-color: #1e1e1e;
    color: #F3F4F6;
}

/* ── Content ── */
#content {
    background-color: #111111;
}

/* ── Cards ── */
QFrame#card {
    background-color: #1e1e1e;
    border-radius: 0px;
    border: 1px solid #2e2e2e;
}

/* ── Inputs ── */
QLineEdit, QDateEdit, QTimeEdit {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 0px;
    padding: 6px 10px;
    color: #F3F4F6;
    min-height: 34px;
}

QLineEdit:focus, QDateEdit:focus, QTimeEdit:focus {
    border: 1px solid #E60012;
}

QLineEdit:read-only {
    background-color: #212121;
    color: #555555;
    border-color: #2e2e2e;
}

QPlainTextEdit {
    background-color: #2a2a2a;
    color: #F3F4F6;
    border: 1px solid #E60012;
    border-radius: 4px;
    font-size: 11px;
    padding: 4px;
}

QComboBox {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 0px;
    padding: 6px 10px;
    color: #F3F4F6;
    min-height: 34px;
}

QComboBox:focus {
    border: 1px solid #E60012;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #222222;
    border: 1px solid #3a3a3a;
    selection-background-color: #2e2e2e;
    color: #F3F4F6;
}

/* ── Buttons ── */
QPushButton {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 0px;
    padding: 7px 16px;
    color: #9CA3AF;
    font-weight: 500;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #333333;
    border-color: #444444;
    color: #F3F4F6;
}

QPushButton:pressed {
    background-color: #1e1e1e;
    border-color: #3a3a3a;
}

QPushButton:disabled {
    background-color: #1e1e1e;
    border-color: #2e2e2e;
    color: #444444;
}

QPushButton#btn_primary {
    background-color: #E60012;
    border: 1px solid #C0000F;
    color: #ffffff;
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton#btn_primary:hover {
    background-color: #C0000F;
    border-color: #8a1708;
}

QPushButton#btn_primary:pressed {
    background-color: #8a1708;
}

QPushButton#btn_primary:disabled {
    background-color: #3a1a1a;
    border-color: #2e1010;
    color: #6B7280;
}

QPushButton#btn_danger {
    background-color: #212121;
    border: 1px solid #3a3a3a;
    color: #E60012;
}

QPushButton#btn_danger:hover {
    background-color: #222222;
    border-color: #E60012;
}

/* ── Tables ── */
QTableWidget {
    background-color: #212121;
    border: 1px solid #2e2e2e;
    border-radius: 0px;
    gridline-color: #2e2e2e;
}

QTableWidget::item {
    padding: 5px 8px;
    color: #F3F4F6;
    background-color: #1e1e1e;
    border-bottom: 1px solid #2e2e2e;
}

QTableWidget::item:alternate {
    background-color: #212121;
}

QTableWidget::item:selected {
    background-color: #2a2a2a;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #111111;
    color: #6B7280;
    border: none;
    border-bottom: 1px solid #2e2e2e;
    border-right: 1px solid #2e2e2e;
    padding: 5px 8px;
    font-weight: bold;
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ── ScrollBar ── */
QScrollBar:vertical {
    background: #212121;
    width: 7px;
    border-radius: 0px;
}

QScrollBar::handle:vertical {
    background: #3a3a3a;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4a4a4a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #212121;
    height: 7px;
    border-radius: 0px;
}

QScrollBar::handle:horizontal {
    background: #3a3a3a;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #4a4a4a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── Tabs ── */
QTabWidget::pane {
    background-color: transparent;
    border: none;
}

QTabBar::tab {
    background-color: #212121;
    color: #555555;
    padding: 8px 22px;
    margin-right: 2px;
    border-radius: 0px;
    font-size: 10pt;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    background-color: #222222;
    color: #F3F4F6;
    border-bottom: 2px solid #E60012;
}

QTabBar::tab:hover:!selected {
    background-color: #1e1e1e;
    color: #9CA3AF;
}

/* ── Labels ── */
QLabel#page_title {
    font-size: 13pt;
    font-weight: bold;
    color: #F3F4F6;
    letter-spacing: 2px;
}

QLabel#section_header {
    font-size: 10pt;
    font-weight: bold;
    color: #F3F4F6;
    border-left: 2px solid #E60012;
    padding-left: 8px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

QLabel#field_label {
    color: #6B7280;
    font-size: 9pt;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* ── Login ── */
QFrame#login_card {
    background-color: #212121;
    border-radius: 0px;
    border: 1px solid #2e2e2e;
}

/* ── Tooltip ── */
QToolTip {
    background-color: #222222;
    color: #F3F4F6;
    border: 1px solid #E60012;
    padding: 4px 8px;
    border-radius: 0px;
}

/* ── Dialog / MessageBox ── */
QMessageBox {
    background-color: #212121;
}

QMessageBox QPushButton {
    min-width: 80px;
}

QDialog {
    background-color: #212121;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ── SpinBox ── */
QDoubleSpinBox, QSpinBox {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 0px;
    padding: 4px 8px;
    color: #F3F4F6;
    min-height: 30px;
}

QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #E60012;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #333333;
    border: none;
    border-left: 1px solid #3a3a3a;
    width: 18px;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #3e3e3e;
}

/* ── CheckBox ── */
QCheckBox {
    color: #6B7280;
    font-size: 10px;
    letter-spacing: 1px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    background: #E60012;
    border: 1px solid #C0000F;
}

QCheckBox::indicator:unchecked {
    background: #1e1e1e;
    border: 1px solid #3a3a3a;
}
