/* =============================================================================
   MKM Productivity System — Light Theme
   BG_APP #F5F5F5 | BG_CARD #FFFFFF | BG_INPUT #FFFFFF
   ACCENT #da291c | TEXT_PRIMARY #1a1a1a | TEXT_SEC #888888 | BORDER #E0E0E0
   ============================================================================= */

* {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #1a1a1a;
}

QMainWindow, QWidget {
    background-color: #F5F5F5;
}

#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E0E0E0;
}

#sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    padding: 10px 10px 10px 40px;
    text-align: left;
    color: #AAAAAA;
    font-size: 10pt;
}

#sidebar QPushButton:hover {
    background-color: #F5F5F5;
    color: #1a1a1a;
    border-left: 3px solid #E0E0E0;
}

#sidebar QLabel#app_title {
    color: #da291c;
    font-size: 13pt;
    font-weight: bold;
    padding: 16px;
    letter-spacing: 3px;
}

#sidebar QLabel#app_subtitle {
    color: #AAAAAA;
    font-size: 8pt;
    padding: 0px 16px 16px 16px;
    letter-spacing: 1px;
}

#content { background-color: #F5F5F5; }

QFrame#card {
    background-color: #FFFFFF;
    border-radius: 0px;
    border: 1px solid #E0E0E0;
}

QLineEdit, QDateEdit, QTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 0px;
    padding: 6px 10px;
    color: #1a1a1a;
    min-height: 34px;
}

QLineEdit:focus, QDateEdit:focus, QTimeEdit:focus { border: 1px solid #da291c; }
QLineEdit:read-only { background-color: #F5F5F5; color: #AAAAAA; }

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 0px;
    padding: 6px 10px;
    color: #1a1a1a;
    min-height: 34px;
}

QComboBox:focus { border: 1px solid #da291c; }
QComboBox::drop-down { border: none; width: 24px; }

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    selection-background-color: #F0F0F0;
    color: #1a1a1a;
}

QPushButton {
    background-color: #EEEEEE;
    border: none;
    border-radius: 0px;
    padding: 7px 16px;
    color: #666666;
    min-height: 30px;
}

QPushButton:hover { background-color: #E0E0E0; color: #1a1a1a; }
QPushButton:pressed { background-color: #D0D0D0; }

QPushButton#btn_primary {
    background-color: #da291c;
    color: #ffffff;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
}

QPushButton#btn_primary:hover { background-color: #b01e0a; }

QPushButton#btn_danger {
    background-color: #FFEBEE;
    color: #da291c;
    border: 1px solid #FFCDD2;
}

QPushButton#btn_danger:hover { background-color: #FFCDD2; }

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 0px;
    gridline-color: #F0F0F0;
}

QTableWidget::item {
    padding: 5px 8px;
    color: #1a1a1a;
    background-color: #FFFFFF;
    border-bottom: 1px solid #F0F0F0;
}

QTableWidget::item:alternate { background-color: #F8F8F8; }
QTableWidget::item:selected { background-color: #F0F0F0; color: #1a1a1a; }

QHeaderView::section {
    background-color: #F5F5F5;
    color: #888888;
    border: none;
    border-bottom: 1px solid #E0E0E0;
    border-right: 1px solid #E8E8E8;
    padding: 5px 8px;
    font-weight: bold;
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QScrollBar:vertical { background: #F0F0F0; width: 6px; border-radius: 0px; }
QScrollBar::handle:vertical { background: #CCCCCC; border-radius: 0px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: #BBBBBB; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar:horizontal { background: #F0F0F0; height: 6px; border-radius: 0px; }
QScrollBar::handle:horizontal { background: #CCCCCC; border-radius: 0px; }
QScrollBar::handle:horizontal:hover { background: #BBBBBB; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

QTabWidget::pane { background-color: transparent; border: none; }

QTabBar::tab {
    background-color: #EEEEEE;
    color: #AAAAAA;
    padding: 8px 22px;
    margin-right: 2px;
    border-radius: 0px;
    font-size: 10pt;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
}

QTabBar::tab:selected { background-color: #FFFFFF; color: #1a1a1a; border-bottom: 2px solid #da291c; }
QTabBar::tab:hover:!selected { background-color: #E8E8E8; color: #1a1a1a; }

QLabel#page_title { font-size: 13pt; font-weight: bold; color: #1a1a1a; letter-spacing: 2px; }

QLabel#section_header {
    font-size: 10pt; font-weight: bold; color: #1a1a1a;
    border-left: 2px solid #da291c; padding-left: 8px;
    letter-spacing: 1px; text-transform: uppercase;
}

QLabel#field_label { color: #888888; font-size: 9pt; letter-spacing: 1px; text-transform: uppercase; }

QFrame#login_card {
    background-color: #FFFFFF;
    border-radius: 0px;
    border: 1px solid #E0E0E0;
}

QToolTip {
    background-color: #FFFFFF;
    color: #1a1a1a;
    border: 1px solid #da291c;
    padding: 4px 8px;
    border-radius: 0px;
}

QMessageBox { background-color: #FFFFFF; }
QMessageBox QPushButton { min-width: 80px; }
QDialog { background-color: #FFFFFF; }
QDialogButtonBox QPushButton { min-width: 80px; }

QDoubleSpinBox, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 0px;
    padding: 4px 8px;
    color: #1a1a1a;
    min-height: 30px;
}

QDoubleSpinBox:focus, QSpinBox:focus { border: 1px solid #da291c; }

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #EEEEEE; border: none; width: 18px;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #E0E0E0;
}
