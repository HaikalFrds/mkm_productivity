/* =============================================================================
   MKM Productivity System — Light Theme (Mitsubishi Corporate Palette)
   60% BG    : #F8F9FA (off-white)  | #FFFFFF (card/input)
   30% STRUCT: #D1D5DB (border)     | #212121 (text)
   10% ACCENT: #E60012 (Mitsubishi Red)
   STATUS    : #28A745 OK | #FFC107 Warning | #E60012 NG/Critical
   ============================================================================= */

* {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #212121;
}

QMainWindow, QWidget {
    background-color: #F8F9FA;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */

#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #D1D5DB;
}

#sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    padding: 10px 10px 10px 40px;
    text-align: left;
    color: #9CA3AF;
    font-size: 10pt;
}

#sidebar QPushButton:hover {
    background-color: #F8F9FA;
    color: #212121;
    border-left: 3px solid #D1D5DB;
}

#sidebar QLabel#app_title {
    color: #E60012;
    font-size: 13pt;
    font-weight: bold;
    padding: 16px;
    letter-spacing: 3px;
}

#sidebar QLabel#app_subtitle {
    color: #9CA3AF;
    font-size: 8pt;
    padding: 0px 16px 16px 16px;
    letter-spacing: 1px;
}

#content { background-color: #F8F9FA; }

/* ── Cards ───────────────────────────────────────────────────────────────── */

QFrame#card {
    background-color: #FFFFFF;
    border-radius: 0px;
    border: 1px solid #D1D5DB;
}

/* ── Inputs ──────────────────────────────────────────────────────────────── */

QLineEdit, QDateEdit, QTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 0px;
    padding: 6px 10px;
    color: #212121;
    min-height: 34px;
}

QLineEdit:focus, QDateEdit:focus, QTimeEdit:focus { border: 1px solid #E60012; }
QLineEdit:read-only { background-color: #F8F9FA; color: #9CA3AF; }

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 0px;
    padding: 6px 10px;
    color: #212121;
    min-height: 34px;
}

QComboBox:focus { border: 1px solid #E60012; }
QComboBox::drop-down { border: none; width: 24px; }

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    selection-background-color: #F3F4F6;
    color: #212121;
}

/* ── Buttons ─────────────────────────────────────────────────────────────── */

QPushButton {
    background-color: #F3F4F6;
    border: none;
    border-radius: 0px;
    padding: 7px 16px;
    color: #4B5563;
    min-height: 30px;
}

QPushButton:hover    { background-color: #D1D5DB; color: #212121; }
QPushButton:pressed  { background-color: #9CA3AF; }
QPushButton:disabled { background-color: #F3F4F6; color: #9CA3AF; }

/* Tombol aksi utama — Mitsubishi Red */
QPushButton#btn_primary {
    background-color: #E60012;
    color: #FFFFFF;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QPushButton#btn_primary:hover   { background-color: #C0000F; }
QPushButton#btn_primary:pressed { background-color: #A0000C; }

/* Tombol bahaya / hapus */
QPushButton#btn_danger {
    background-color: #FFF0F0;
    color: #E60012;
    border: 1px solid #FFCDD2;
}
QPushButton#btn_danger:hover { background-color: #FFCDD2; }

/* ── Table ───────────────────────────────────────────────────────────────── */

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 0px;
    gridline-color: #F3F4F6;
}

QTableWidget::item {
    padding: 5px 8px;
    color: #212121;
    background-color: #FFFFFF;
    border-bottom: 1px solid #F3F4F6;
}

QTableWidget::item:alternate { background-color: #F9FAFB; }
QTableWidget::item:selected  { background-color: #F3F4F6; color: #212121; }

QHeaderView::section {
    background-color: #F8F9FA;
    color: #6B7280;
    border: none;
    border-bottom: 1px solid #D1D5DB;
    border-right: 1px solid #E5E7EB;
    padding: 5px 8px;
    font-weight: bold;
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ── Scrollbar ───────────────────────────────────────────────────────────── */

QScrollBar:vertical   { background: #F3F4F6; width: 6px;  border-radius: 0px; }
QScrollBar:horizontal { background: #F3F4F6; height: 6px; border-radius: 0px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #D1D5DB; border-radius: 0px; min-height: 20px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical   { height: 0px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

/* ── Tabs ────────────────────────────────────────────────────────────────── */

QTabWidget::pane { background-color: transparent; border: none; }

QTabBar::tab {
    background-color: #F3F4F6;
    color: #9CA3AF;
    padding: 8px 22px;
    margin-right: 2px;
    border-radius: 0px;
    font-size: 10pt;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
}

QTabBar::tab:selected          { background-color: #FFFFFF; color: #212121; border-bottom: 2px solid #E60012; }
QTabBar::tab:hover:!selected   { background-color: #E5E7EB; color: #212121; }

/* ── Labels ──────────────────────────────────────────────────────────────── */

QLabel#page_title {
    font-size: 13pt; font-weight: bold; color: #212121; letter-spacing: 2px;
}

QLabel#section_header {
    font-size: 10pt; font-weight: bold; color: #212121;
    border-left: 2px solid #E60012; padding-left: 8px;
    letter-spacing: 1px; text-transform: uppercase;
}

QLabel#field_label { color: #6B7280; font-size: 9pt; letter-spacing: 1px; text-transform: uppercase; }

/* ── Dialogs & misc ──────────────────────────────────────────────────────── */

QFrame#login_card {
    background-color: #FFFFFF;
    border-radius: 0px;
    border: 1px solid #D1D5DB;
}

QToolTip {
    background-color: #FFFFFF;
    color: #212121;
    border: 1px solid #E60012;
    padding: 4px 8px;
    border-radius: 0px;
}

QMessageBox         { background-color: #FFFFFF; }
QMessageBox QPushButton { min-width: 80px; }
QDialog             { background-color: #FFFFFF; }
QDialogButtonBox QPushButton { min-width: 80px; }

/* ── SpinBox ─────────────────────────────────────────────────────────────── */

QDoubleSpinBox, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 0px;
    padding: 4px 8px;
    color: #212121;
    min-height: 30px;
}

QDoubleSpinBox:focus, QSpinBox:focus { border: 1px solid #E60012; }

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #F3F4F6; border: none; width: 18px;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #D1D5DB;
}
