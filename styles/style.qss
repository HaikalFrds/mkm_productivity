/* MKM Productivity System — Ferrari Industrial Dark */

* {
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #ffffff;
}

QMainWindow, QWidget {
    background-color: #181818;
}

/* ── Sidebar ───────────────────────────────────────────────────────────────── */

#sidebar {
    background-color: #111111;
    border-right: 1px solid #303030;
}

#sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    padding: 10px 10px 10px 40px;
    text-align: left;
    color: #969696;
    font-size: 10pt;
}

#sidebar QPushButton:hover {
    background-color: #252525;
    color: #ffffff;
    border-left: 3px solid #303030;
}

#sidebar QPushButton[active="true"] {
    background-color: #252525;
    color: #ffffff;
    border-left: 3px solid #da291c;
}

#sidebar QLabel#app_title {
    color: #da291c;
    font-size: 13pt;
    font-weight: bold;
    padding: 16px;
}

#sidebar QLabel#app_subtitle {
    color: #666666;
    font-size: 9pt;
    padding: 0px 16px 16px 16px;
}

/* ── Content ───────────────────────────────────────────────────────────────── */

#content {
    background-color: #181818;
}

/* ── Cards ─────────────────────────────────────────────────────────────────── */

QFrame#card {
    background-color: #252525;
    border-radius: 0px;
    border: 1px solid #303030;
}

/* ── Inputs ────────────────────────────────────────────────────────────────── */

QLineEdit, QDateEdit, QTimeEdit, QComboBox {
    background-color: #1e1e1e;
    border: 1px solid #303030;
    border-radius: 2px;
    padding: 6px 10px;
    color: #ffffff;
    min-height: 28px;
}

QLineEdit:focus, QDateEdit:focus, QTimeEdit:focus, QComboBox:focus {
    border: 1px solid #da291c;
}

QLineEdit:read-only {
    background-color: #252525;
    color: #666666;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #252525;
    border: 1px solid #303030;
    selection-background-color: #303030;
    color: #ffffff;
}

/* ── Buttons ───────────────────────────────────────────────────────────────── */

QPushButton {
    background-color: #252525;
    border: none;
    border-radius: 0px;
    padding: 7px 16px;
    color: #969696;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #303030;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1e1e1e;
}

QPushButton#btn_primary {
    background-color: #da291c;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#btn_primary:hover {
    background-color: #b01e0a;
}

QPushButton#btn_danger {
    background-color: #5c1a1a;
    color: #ff9696;
}

QPushButton#btn_danger:hover {
    background-color: #731f1f;
}

/* ── Tables ────────────────────────────────────────────────────────────────── */

QTableWidget {
    background-color: #1e1e1e;
    border: 1px solid #303030;
    border-radius: 0px;
    gridline-color: #303030;
}

QTableWidget::item {
    padding: 6px;
    color: #ffffff;
    background-color: #252525;
    border-bottom: 1px solid #303030;
}

QTableWidget::item:selected {
    background-color: #303030;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #111111;
    color: #969696;
    border: none;
    border-bottom: 1px solid #303030;
    border-right: 1px solid #303030;
    padding: 6px;
    font-weight: bold;
    font-size: 9pt;
}

/* ── ScrollBar ─────────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: #181818;
    width: 6px;
    border-radius: 0px;
}

QScrollBar::handle:vertical {
    background: #303030;
    border-radius: 0px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #484848;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #181818;
    height: 6px;
    border-radius: 0px;
}

QScrollBar::handle:horizontal {
    background: #303030;
    border-radius: 0px;
}

QScrollBar::handle:horizontal:hover {
    background: #484848;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── Labels ────────────────────────────────────────────────────────────────── */

QLabel#page_title {
    font-size: 15pt;
    font-weight: bold;
    color: #ffffff;
    padding: 4px 0px;
}

QLabel#section_header {
    font-size: 11pt;
    font-weight: bold;
    color: #ffffff;
    border-bottom: 1px solid #303030;
    padding-bottom: 6px;
}

QLabel#field_label {
    color: #969696;
    font-size: 10pt;
}

/* ── Login ─────────────────────────────────────────────────────────────────── */

QFrame#login_card {
    background-color: #252525;
    border-radius: 0px;
    border: 1px solid #303030;
}

/* ── Dialog / MessageBox ───────────────────────────────────────────────────── */

QMessageBox {
    background-color: #252525;
}

QMessageBox QPushButton {
    min-width: 80px;
}

QDialog {
    background-color: #252525;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}
